@page "/Error"
@using System.Diagnostics

<PageTitle>Something went wrong · Shared Todo</PageTitle>

<div class="status-page" role="alert">
    <div class="empty-icon danger"><Icon Name="x" Size="28" /></div>
    <h1>Something went wrong</h1>
    <p class="muted">An unexpected error occurred. Your data is safe. Please try again in a moment.</p>
    @if (ShowRequestId)
    {
        <p class="small muted">Reference: <code>@RequestId</code></p>
    }
    <a class="btn btn-primary" href="">Back to my lists</a>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
