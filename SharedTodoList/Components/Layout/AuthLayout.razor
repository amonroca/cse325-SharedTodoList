@inherits LayoutComponentBase

<a class="skip-link" href="#main-content">Skip to sign-in form</a>

<div class="auth-page">
    <section class="auth-hero" aria-label="About Shared Todo">
        <div class="brand">
            <span class="brand-mark"><Icon Name="check" Size="20" /></span>
            Shared Todo
        </div>
        <h2>Get things done, together.</h2>
        <p>Create task lists and share them with classmates, coworkers, or family. Everyone stays on the same page.</p>
        <ul class="hero-points">
            <li><Icon Name="list" /> Organize tasks into lists</li>
            <li><Icon Name="users" /> Share lists by email, updates appear live</li>
            <li><Icon Name="calendar" /> Track due dates and priorities</li>
        </ul>
    </section>

    <main class="auth-card-wrap" id="main-content" tabindex="-1">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet role="alert">
    Something went wrong. Please reload the page to continue.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
